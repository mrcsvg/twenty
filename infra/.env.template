# Twenty CRM — .env template
# DO NOT commit the resolved .env. It is generated on the VM by vm-startup.sh
# from Secret Manager + the VM's external IP.
#
# Variables consumed by docker-compose.yml:

CRM_DOMAIN=crm.<IP_WITH_DASHES>.nip.io
SERVER_URL=https://${CRM_DOMAIN}
APP_SECRET=<generated by Secret Manager>
PG_PASSWORD=<generated by Secret Manager>

# Optional — pin the image tag. Defaults to "latest".
# TAG=v0.40.0
